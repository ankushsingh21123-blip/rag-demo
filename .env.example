# Copy to .env and fill in your own values. Never commit .env.
# Local pgvector container (see docker-compose.yml):
DATABASE_URL=postgresql://ragdemo:ragdemo@localhost:5432/ragdemo
# Or a Supabase Postgres connection string (pgvector is available there).
# Leave GEMINI_API_KEY empty to run the demo-only fallback paths ($0, no keys).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
# STORE=postgres (default) or STORE=memory (no database, for quick local runs/tests)
STORE=postgres
